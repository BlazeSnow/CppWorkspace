{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build active file",
            "command": "cmd",
            "args": [
                "/c",
                "chcp 65001 >nul && del /f \"${fileDirname}\\${fileBasenameNoExtension}.exe\" 2>nul & D:\\scoop\\apps\\mingw\\current\\bin\\g++.exe -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -finput-charset=UTF-8 -fexec-charset=UTF-8 -std=c++26"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译当前文件: g++ -g -std=c++26 …"
        }
    ]
}
